# Copy to .env (the .env file is not committed to git)
# true  = run on contracts/fixtures, no backend needed (default)
# false = call the live API from P1 (via the /api -> localhost:8000 proxy)
VITE_USE_MOCK=true
# Only needed for deployment, if the API lives on another domain:
# VITE_API_URL=https://example.com/api/v1
