# Скопируй в .env (файл .env в git не попадает)
# true  = работаем на contracts/fixtures, бэкенд не нужен (по умолчанию)
# false = ходим в живой API P1 (через прокси /api -> localhost:8000)
VITE_USE_MOCK=true
# Нужен только для деплоя, если API на другом домене:
# VITE_API_URL=https://example.com/api/v1
